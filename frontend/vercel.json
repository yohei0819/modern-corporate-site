{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "curl -s --max-time 120 https://recruit-api-sop3.onrender.com/up > /dev/null && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "env": {
    "API_URL": "https://recruit-api-sop3.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://recruit-api-sop3.onrender.com"
  }
}
